{
  "name": "opengrokbot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Your own AI company in a group chat: employees with personas that talk to you and to each other, running on the subscriptions you already pay for (Claude, Codex, Gemini) or any API (Kimi, OpenRouter, Ollama…). Grok Bot, but open and yours.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "tsc -p tsconfig.server.json && node --test dist/server/*.test.js",
    "desktop": "node desktop/launch.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.270",
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "electron": "^38.8.6",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "main": "desktop/main.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Z4YT0N/OpenGrokBotBot"
  },
  "homepage": "https://github.com/Z4YT0N/OpenGrokBotBot"
}
